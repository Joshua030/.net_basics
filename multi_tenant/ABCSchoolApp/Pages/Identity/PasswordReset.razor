<MudForm @ref="_form" Model="ChangePasswordRequest">
    <MudCard Elevation="25">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText>
                    Reset Password
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ChangePasswordRequest.NewPassword"
                                  Variant="Variant.Outlined"
                                  Label="New Password"
                                  InputType="_newPasswordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_newPasswordInputIcon"
                                  OnAdornmentClick="@(() => TogglePasswordVisibility(true))" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ChangePasswordRequest.ConfirmNewPassword"
                                  Variant="Variant.Outlined"
                                  Label="Confirm New Password"
                                  InputType="_newPasswordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_newPasswordInputIcon"
                                  OnAdornmentClick="@(() => TogglePasswordVisibility(true))" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ChangePasswordRequest.CurrentPassword"
                                  Label="Current Pasword"
                                  Variant="Variant.Outlined"
                                  InputType="_currentPasswordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_currentPasswordInputIcon"
                                  OnAdornmentClick="@(() => TogglePasswordVisibility(false))" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ml-auto" OnClick="ResetPasswordAsync">
                Reset Password
            </MudButton>
        </MudCardActions>
    </MudCard>

</MudForm>