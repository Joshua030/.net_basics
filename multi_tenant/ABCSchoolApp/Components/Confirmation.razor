<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@InputIcon" Class="mr-3 mb-n1" />
            @Title
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Confirmed">
            @ButtonText
        </MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="OnCancel">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>