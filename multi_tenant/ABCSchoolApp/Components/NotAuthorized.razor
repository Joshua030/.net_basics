@page "/not-authorized"

<MudContainer MaxWidth="MaxWidth.ExtraSmall"
              Class="d-flex flex-column justify-content-center align-center"
              Style="min-height: 70vh;">
    <MudCard Class="pa-6" Style="text-align:center;">
        <MudCardContent>
            <MudAvatar Color="Color.Error" Size="Size.Large" Class="mb-4" />
            <MudText>You're not authorized</MudText>

            <MudText Class="mb-4">
                Sorry, you don have permission to view this page.
                @if (!string.IsNullOrEmpty(Message))
                {
                    <div>@Message</div>
                }
            </MudText>
            <MudButton OnClick="GoToHome" Variant="Variant.Filled" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="mr-2" />
                Go To Home
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter]
    public string? Message { get; set; }

    private void GoToHome()
    {
        _navigation.NavigateTo("/");
    }
}
