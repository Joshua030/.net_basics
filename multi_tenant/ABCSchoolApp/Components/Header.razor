<MudCard Elevation="0">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-2">@Title</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="mb-2">@Description</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Text" Color="Color.Info" Class="ml-auto" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@HandleReturn">
                BACK
            </MudButton>
        </CardHeaderActions>
    </MudCardHeader>
</MudCard>
