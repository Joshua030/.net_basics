{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    "BaseApiUrl": "https://localhost:7062/api/",
    "TokenEndPoints": {
      "Login": "token/login",
      "RefreshToken": "token/refresh-token"
    },
    "UserEndPoints": {
      "Update": "users/update",
      "ResetPassword": "users/change-password"
    },
    "TenantEndPoints": {
      "Create": "tenants/add",
      "Upgrade": "tenants/upgrade",
      "GetAll": "tenants/all",
      "ById": "tenants",
      "Activate": "tenants",
      "Deactivate": "tenants"
    }

  }
}